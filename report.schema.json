{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulkanScope Database Submission",
  "type": "object",
  "required": [
    "schemaVersion",
    "application",
    "device",
    "gpu",
    "driver",
    "vulkan",
    "collection",
    "reportText"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "application": {
      "type": "object"
    },
    "device": {
      "type": "object"
    },
    "gpu": {
      "type": "object"
    },
    "driver": {
      "type": "object"
    },
    "vulkan": {
      "type": "object"
    },
    "collection": {
      "type": "object"
    },
    "reportText": {
      "type": "string",
      "minLength": 1000
    },
    "technicalReport": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 3
        }
      },
      "required": [
        "schemaVersion"
      ]
    }
  }
}
