{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VulkanScope Database Submission",
  "type": "object",
  "required": [
    "schemaVersion",
    "application",
    "device",
    "gpu",
    "driver",
    "vulkan",
    "collection",
    "technicalReport",
    "reportText"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "application": {
      "type": "object",
      "required": [
        "name",
        "packageName",
        "version",
        "versionCode",
        "applicationAbi",
        "supportedDeviceAbis"
      ],
      "properties": {
        "name": {
          "const": "VulkanScope"
        },
        "packageName": {
          "const": "com.efishell.vulkanscope"
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^3\\.(?:0\\.(?:1[2-9]|[2-9][0-9]+|[1-9][0-9]{2,})|[1-9][0-9]*\\.[0-9]+)$",
          "description": "New submissions require VulkanScope 3.0.12 or newer within the fail-closed 3.x versionCode identity scheme."
        },
        "versionCode": {
          "type": [
            "integer",
            "number"
          ],
          "minimum": 3012
        },
        "applicationAbi": {
          "type": "string",
          "maxLength": 64
        },
        "supportedDeviceAbis": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 32
        }
      },
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "required": [
        "platform",
        "chromeOsArcRuntime",
        "androidPcFormFactor",
        "freeformWindowManagement",
        "googlebookEnvironmentEvidence",
        "googlebookOsVersion",
        "hostOsVersion",
        "manufacturer",
        "brand",
        "model",
        "device",
        "product",
        "androidRelease",
        "sdk",
        "securityPatch"
      ],
      "properties": {
        "manufacturer": {
          "type": "string",
          "maxLength": 256
        },
        "model": {
          "type": "string",
          "maxLength": 256
        },
        "androidRelease": {
          "type": "string",
          "maxLength": 64
        },
        "sdk": {
          "type": [
            "integer",
            "number"
          ]
        },
        "brand": {
          "type": "string",
          "maxLength": 256
        },
        "device": {
          "type": "string",
          "maxLength": 256
        },
        "product": {
          "type": "string",
          "maxLength": 256
        },
        "securityPatch": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 64
        },
        "platform": {
          "type": "string",
          "maxLength": 256
        },
        "chromeOsArcRuntime": {
          "type": "boolean"
        },
        "androidPcFormFactor": {
          "type": "boolean"
        },
        "freeformWindowManagement": {
          "type": "boolean"
        },
        "googlebookEnvironmentEvidence": {
          "type": "string",
          "maxLength": 1024
        },
        "googlebookOsVersion": {
          "type": "string",
          "maxLength": 256
        },
        "hostOsVersion": {
          "type": "string",
          "maxLength": 256
        }
      },
      "additionalProperties": false
    },
    "gpu": {
      "type": "object",
      "required": [
        "name",
        "vendorId",
        "deviceId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "vendorId": {
          "type": "string",
          "maxLength": 64
        },
        "deviceId": {
          "type": "string",
          "maxLength": 64
        },
        "deviceType": {
          "type": "string",
          "maxLength": 128
        },
        "summaryScope": {
          "type": "string",
          "enum": [
            "singlePhysicalDevice",
            "firstPhysicalDeviceCompatibilitySummary"
          ]
        },
        "physicalDeviceCount": {
          "type": [
            "integer",
            "number"
          ],
          "minimum": 1,
          "maximum": 32
        }
      },
      "additionalProperties": false
    },
    "driver": {
      "type": "object",
      "required": [
        "mode",
        "version"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "maxLength": 512
        },
        "rawVersion": {
          "type": [
            "string",
            "integer",
            "number"
          ]
        },
        "summaryScope": {
          "type": "string",
          "enum": [
            "singlePhysicalDevice",
            "firstPhysicalDeviceCompatibilitySummary"
          ]
        }
      },
      "additionalProperties": false
    },
    "vulkan": {
      "type": "object",
      "required": [
        "loaderInstanceApiVersion",
        "deviceApiVersion",
        "registryBaseline",
        "headerBaseline",
        "reportSchema"
      ],
      "properties": {
        "loaderInstanceApiVersion": {
          "type": "string",
          "maxLength": 64
        },
        "deviceApiVersion": {
          "type": "string",
          "maxLength": 64
        },
        "registryBaseline": {
          "type": "string",
          "maxLength": 128
        },
        "headerBaseline": {
          "type": "string",
          "maxLength": 128
        },
        "reportSchema": {
          "type": "string",
          "maxLength": 128
        },
        "loaderApiVersion": {
          "type": "string",
          "maxLength": 64
        },
        "instanceApiVersion": {
          "type": "string",
          "maxLength": 64
        },
        "deviceApiSummaryScope": {
          "type": "string",
          "enum": [
            "singlePhysicalDevice",
            "firstPhysicalDeviceCompatibilitySummary"
          ]
        }
      },
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "required": [
        "status",
        "deviceCount",
        "error"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "deviceCount": {
          "type": [
            "integer",
            "number"
          ],
          "minimum": 1,
          "maximum": 32
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "reportText": {
      "type": "string",
      "minLength": 1000,
      "maxLength": 2097152
    },
    "technicalReport": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 3
        }
      },
      "required": [
        "schemaVersion"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
